# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Run outputs: regenerable by `make reproduce`, never committed.
runs/
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
reports/figures/*
!reports/figures/.gitkeep
reports/*.xlsx
reports/*.html
reports/VALIDATION.md
reports/SUPPLEMENTARY_INFORMATION.md
reports/scaffold_diversity.csv
reports/known_actives_template.csv
reports/known_actives_README.md
reports/dossiers/

# Fetched structures are cached, checksummed and regenerable.
data/raw/pdb_cache/*
!data/raw/pdb_cache/.gitkeep

# OS
.DS_Store
